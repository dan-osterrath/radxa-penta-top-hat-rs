# Copy this file to /etc/rockpi-penta.env and replace the placeholders with
# the Linux device paths and line offsets for the board and kernel in use.
SDA=SDA
SCL=SCL
OLED_I2C_DEVICE=/dev/i2c-N
OLED_RESET=N
BUTTON_CHIP=/dev/gpiochipN
BUTTON_LINE=N
# Use output-poll for Penta HAT variants whose button is read through an
# output held high by the controller.
BUTTON_MODE=edge
FAN_CHIP=/dev/gpiochipN
FAN_LINE=N
HARDWARE_PWM=0

# For hardware PWM, remove FAN_CHIP/FAN_LINE, set HARDWARE_PWM=1, and add:
# PWMCHIP=N
